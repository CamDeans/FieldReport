# Demo mode (default): leave Supabase unset. Reports use OpenAI when OPENAI_API_KEY is set,
# otherwise the taxonomy rule engine as fail-safe. Data lives in .fieldreport/

# --- Live production ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Primary report author + Whisper + scope suggest (taxonomy is fallback only)
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=FieldReport <reports@fieldreport.app>

# Web billing (Stripe). Native IAP uses RevenueCat instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_TRIAL_DAYS=7

# RevenueCat (Shipaton / App Store / Play). Public keys are safe for the client.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Optional product id overrides (defaults: fieldreport_{plan}_monthly)
NEXT_PUBLIC_REVENUECAT_PRODUCT_STARTER=
NEXT_PUBLIC_REVENUECAT_PRODUCT_PRO=
NEXT_PUBLIC_REVENUECAT_PRODUCT_TEAM=
# Legacy aliases (still supported if preferred unset)
NEXT_PUBLIC_RC_PRODUCT_STARTER=
NEXT_PUBLIC_RC_PRODUCT_PRO=
NEXT_PUBLIC_RC_PRODUCT_TEAM=

# Extra promo codes as CODE:plan pairs, comma-separated (builtin: SHIPATON-JUDGE → pro)
PROMO_CODES=

# Deployed origin — Capacitor WebView + Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
CAPACITOR_SERVER_URL=http://localhost:3000
